# SQLite database file and folder for uploaded quotations
QUOTELENS_DB=quotelens.db
QUOTELENS_UPLOADS=uploads
QUOTELENS_MAX_UPLOAD_MB=10

# Optional: require "Authorization: Bearer <token>" on POST /api/documents
QUOTELENS_API_TOKEN=

# Flask session key for flash messages (set a long random value outside local development)
SECRET_KEY=change-me

# Optional: lets the model choose tools for /ask. Without it a rule-based router answers.
ANTHROPIC_API_KEY=
QUOTELENS_LLM_MODEL=claude-sonnet-4-6
